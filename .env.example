DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/professors
ADMIN_API_KEY=change-me
CATALOG_URL=https://catalog.marist.edu/content.php?catoid=10&navoid=440
# Optional: use a saved HTML copy when the live catalog returns an AWS WAF challenge.
# CATALOG_HTML_PATH=/app/data/faculty.html
RMP_SCHOOL_ID=563
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Standalone MyMarist request probe.
MYMARIST_REGISTRATION_URL=
# Keep this single-quoted so Docker Compose does not expand $ characters in cookie values.
MYMARIST_COOKIE=''
MYMARIST_USER_AGENT=
MYMARIST_REFERER=
MYMARIST_ORIGIN=
MYMARIST_METHOD=GET
MYMARIST_QUERY={}
MYMARIST_JSON_BODY={}
MYMARIST_EXTRA_HEADERS={}
MYMARIST_FOLLOW_REDIRECTS=false
MYMARIST_SHOW_BODY=false
# Optional safety cap. Leave empty to log the complete response body.
MYMARIST_BODY_MAX_CHARS=
MYMARIST_LOG_PATH=/app/logs/mymarist_probe.txt
