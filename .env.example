DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/professors
ADMIN_API_KEY=change-me
RMP_SCHOOL_ID=563
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Standalone MyMarist request probe.
MYMARIST_REGISTRATION_URL=https://ssb1-reg-prod.banner.marist.edu/StudentRegistrationSsb/ssb/searchResults/searchResults
MYMARIST_TERM=202640
MYMARIST_UNIQUE_SESSION_ID=
MYMARIST_PAGE_MAX_SIZE=1
# Keep this single-quoted so Docker Compose does not expand $ characters in cookie values.
MYMARIST_COOKIE=''
MYMARIST_USER_AGENT=
MYMARIST_REFERER=
MYMARIST_ORIGIN=
MYMARIST_METHOD=GET
MYMARIST_QUERY={}
MYMARIST_JSON_BODY={}
MYMARIST_EXTRA_HEADERS={}
MYMARIST_FOLLOW_REDIRECTS=false
MYMARIST_LOG_PATH=/app/logs/mymarist_probe.txt
MYMARIST_RESPONSE_DIR=/app/logs/responses
MYMARIST_RESPONSE_PREFIX=registration
MYMARIST_REGISTRATION_JSON_PATH=/app/logs/responses/registration_latest.json

# Optional standalone per-CRN detail probe. Keep the default batch small until the endpoint is characterized.
MYMARIST_CRN_DETAIL_URL=
MYMARIST_CRNS=
MYMARIST_CRN_TERM=202640
MYMARIST_CRN_BATCH_SIZE=5
MYMARIST_CRN_DELAY_SECONDS=0.5
MYMARIST_CRN_METHOD=GET
MYMARIST_CRN_PLACEMENT=query
MYMARIST_CRN_PARAM=courseReferenceNumber
MYMARIST_CRN_QUERY={}
MYMARIST_CRN_JSON_BODY={}
MYMARIST_CRN_RESPONSE_DIR=/app/logs/responses/crn-details
